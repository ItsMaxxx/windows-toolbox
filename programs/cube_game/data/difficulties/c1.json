    { "from": 120, "every": 130, "enemy_stats": { "all": { "contact_damage": "x1.1", "projectile_damage": "x1.1", "blast_damage": "x1.1" } }, "announce": "Enemies hit harder!" },
    { "from": 150, "every": 150, "arena": { "armor": "+4" }, "announce": "The walls harden!" },
    { "from": 150, "every": 150, "enemy_stats": { "all": { "base_hp": "+1" } }, "announce": "Enemies +1 HP" },
    { "from": 200, "to": 230, "spawn_interval": "x0.85", "one_of": [
      { "weights": { "cannoneer": "x2" }, "spawn": { "cannoneer": 3 }, "announce": "Cannoneers incoming!" },
      { "weights": { "shield": "x2" }, "spawn": { "shield": 4 }, "announce": "Shields incoming!" },
      { "spawn": { "commander": 2, "fat": 4 }, "announce": "Commanders incoming!" }
    ] },
    { "from": 270, "to": 300, "spawn": { "fat": 3, "commander": 2 }, "spawn_interval": "x0.7", "announce": "Final wave!" },
    { "from": 285, "to": 300, "spawn": { "fat": 3, "cannoneer": 1 }, "spawn_interval": "x0.8", "enemy_stats": { "all": { "contact_damage": "x1.15", "projectile_damage": "x1.15", "blast_damage": "x1.15" } }, "announce": "Hold on!" },
    { "from": 330, "to": 350, "every": 45, "spawn_interval": "x0.8", "one_of": [
      { "spawn": { "commander": 2, "fat": 4 }, "announce": "Commanders incoming!" },
      { "spawn": { "fat": 4, "cannoneer": 2 }, "announce": "Heavy wave!" },
      { "weights": { "shield": "x2" }, "spawn": { "shield": 4 }, "announce": "Shields incoming!" }
    ] },
    { "from": 350, "to": 356, "every": 80, "breathe": 70, "announce": "The arena breathes in!" },
    { "from": 360, "every": 120, "one_of": [
      { "points": { "totem": 1 } },
      { "points": { "nest": 1 } },
      { "points": { "storm": 1 } }
    ] }
