    { "type": "commander", "weight": 8, "after": 30, "growth": 2 },
    { "type": "shield", "weight": 10, "after": 60, "growth": 1 }
  ],
  "swarms": [
    { "type": "fat", "after": 40, "start_chance": 0.025, "chance_growth": 0.0008, "max_chance": 0.13, "start_size": 4, "growth_time": 18, "max_size": 14, "min_gap": 8, "leader": "commander", "leader_chance": 0.6 }
  ],
  "phases": [
    { "from": 0, "to": 20, "spawn": { "fat": 3 }, "spawn_interval": "x0.5" },
