{
  "name": "C1",
  "description": "command: Commanders lead Fat Guy swarms",
  "order": 21,
  "goal": 300,
  "core_chance": 0.2,
  "unlock": { "requires": "b6" },
  "hints": ["Only evolutions from here on", "Commanders make the enemies near them faster and stronger (gold outline)", "Kill the Commander in the middle of a swarm first"],
