    { "type": "charger", "weight": 8, "after": 90 }
  ],
  "swarms": { "type": "basic", "after": 50, "start_chance": 0.025, "chance_growth": 0.0009, "max_chance": 0.14, "start_size": 6, "growth_time": 11, "max_size": 26, "min_gap": 8 },
