    { "from": 165, "every": 135, "enemy_stats": { "all": { "contact_damage": "x1.2", "projectile_damage": "x1.2", "blast_damage": "x1.2" } }, "announce": "Enemies hit harder!" },
    { "from": 180, "to": 210, "weights": { "shooter": "x2", "sniper": "x1.5" }, "spawn": { "sniper": 3, "shooter": 2 }, "spawn_interval": "x0.65", "announce": "Final wave!" },
    { "from": 195, "to": 210, "spawn": { "shooter": 3, "sniper": 2 }, "spawn_interval": "x0.8", "announce": "Hold on!" },
